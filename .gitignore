# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# Virtual environments
# =========================
venv/
.venv/
env/
ENV/

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/

# =========================
# SQLite / application state
# =========================
*.db
*.db-shm
*.db-wal

# =========================
# Environment variables / secrets
# =========================
.env
.env.*
!.env.example

# =========================
# Generated vector database
# =========================
# The Chroma index is intentionally uploaded for the demo so users do not
# need to run the expensive ingestion step. Track it with Git LFS.
vectorstore/*
!vectorstore/chroma/
!vectorstore/chroma/**
/chroma/
/.chroma/

# =========================
# Logs
# =========================
*.log

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# IDE / editor
# =========================
.vscode/
.idea/

# =========================
# Temporary files
# =========================
*.tmp
*.temp
*.bak
